# ---------- LLM (pick one provider) ----------
LLM_PROVIDER=gemini                 # gemini | openai | anthropic | fake
LLM_MODEL=gemini-2.5-flash
ROUTER_MODEL=gemini-2.5-flash-lite  # cheaper model for the guardrail + eval judge
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

EMBEDDING_PROVIDER=gemini           # gemini | openai | hash (offline tests)
EMBEDDING_MODEL=models/gemini-embedding-001

# ---------- Data (leave blank to use bundled demo data) ----------
POLYGON_API_KEY=
SEC_USER_AGENT="BullRunAI your-name your-email@example.com"

# Same values the Flask server uses; blank = in-memory demo user store
FIREBASE_SERVICE_ACCOUNT=
PROJECT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_CLIENT_ID=

# ---------- RAG index ----------
INDEX_DIR=./data/filings_index
# INDEX_GCS_URI=gs://your-bucket/filings_index

# ---------- Agent / API ----------
TOOLS_MODE=local                    # local | mcp
MCP_SERVER_URL=http://localhost:8765/mcp
# CHECKPOINT_DB_URL=postgresql://user:pass@host:5432/db   # durable chat memory
GOOGLE_CLIENT_ID=                   # same OAuth client id as the React app
AUTH_DISABLED=true                  # local dev only; NEVER true in production
CORS_ORIGINS=http://localhost:5173

# ---------- Observability (LangSmith) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bullrun-agent
