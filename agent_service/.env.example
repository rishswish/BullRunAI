# LLM
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
ROUTER_MODEL=gemini-2.5-flash-lite
GOOGLE_API_KEY=

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-001

# Market data
FINNHUB_API_KEY=
POLYGON_API_KEY=
ALLOW_DEMO_DATA=false
SEC_USER_AGENT="BullRunAI your-name your-email@example.com"

# Firestore / brokerage (leave blank locally)
PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_CLIENT_ID=

# Agent API
TOOLS_MODE=local
MCP_SERVER_URL=http://localhost:8765/mcp
INDEX_DIR=./data/filings_index
GOOGLE_CLIENT_ID=
AUTH_DISABLED=true
CORS_ORIGINS=http://localhost:5173

# Tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bullrun-agent
